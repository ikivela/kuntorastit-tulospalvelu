# Gateway for prod.yml (docker-compose.example.yml). The nginx image runs envsubst on this file at
# start-up (only for variables defined in the container, so $host etc. stay).
# BASE_PATH is "" (domain root) or "/kuntorastit" style: leading slash, no
# trailing slash.

# Rate limits for unauthenticated form endpoints (public registration and
# reader device registration), per client IP and only for POST, to stop mass
# spam. Generous enough for many people registering from one shared address
# (mobile carrier NAT, club WiFi). Login has its own limit in the API.
map $request_method $public_form_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $public_form_limit_key zone=public_forms:10m rate=${GATEWAY_FORM_RATE_LIMIT};
limit_req_status 429;

server {
    listen 80;
    server_name ${GATEWAY_SERVER_NAME};

    client_max_body_size ${GATEWAY_MAX_BODY_SIZE};
    server_tokens off;

    # Security headers. The CSP needs 'unsafe-inline' for scripts because the
    # app embeds its hydration data in inline <script> tags; it still blocks
    # third-party scripts, framing by other sites and posting elsewhere.
    # Override with GATEWAY_CSP (e.g. an external API origin in connect-src,
    # or frame-ancestors for embedding the calendar on the club's site).
    add_header Content-Security-Policy "${GATEWAY_CSP}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), serial=(self)" always;

    # Real client IP (used by the API's login rate limiting): trust
    # X-Forwarded-For only from local/private proxies, e.g. the server's own
    # nginx in front of this gateway, and pass on just the resolved address
    # so clients can't spoof it by sending their own header.
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from ::1;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # API: forwarded as-is, the API itself listens under ${BASE_PATH}/api/...
    location ^~ ${BASE_PATH}/api/ {
        proxy_pass http://api:3001;

        location ~ /api/v1/public/(events/[^/]+/registrations|reader-devices/register)$ {
            limit_req zone=public_forms burst=${GATEWAY_FORM_RATE_BURST} nodelay;
            proxy_pass http://api:3001;
        }
    }

    # Build assets: vinext 0.0.50's App Router prod server only serves them
    # at /assets/ (it doesn't strip basePath there), while pages reference
    # ${BASE_PATH}/assets/. Strip the prefix here.
    location ^~ ${BASE_PATH}/assets/ {
        proxy_pass http://web:3000/assets/;
    }

    # Web UI: forwarded as-is, the UI is built with the same base path.
    location ~ ^${BASE_PATH}(/|$) {
        proxy_pass http://web:3000;
    }

    # Anything outside BASE_PATH (only reachable when BASE_PATH is set).
    location / {
        return 404;
    }
}
