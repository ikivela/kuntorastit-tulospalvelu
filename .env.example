# Displayed as the site/brand name in headers, page titles and the footer
# across the public site and admin (see lib/site.ts). Copy this file to
# .env (or .env.local) and adjust as needed — .env* is gitignored.
NEXT_PUBLIC_SITE_NAME=kuntorastit
# Organising club shown under the site name and in the footer (empty = hidden).
NEXT_PUBLIC_CLUB_NAME=
# Branding/defaults (all optional, baked in at build time):
# logo/favicon path under public/ (public/brand/ is gitignored) or https URL
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_FAVICON_URL=
# map centre for new events "lat,lon" (empty = all of Finland) and town
# appended to address searches
NEXT_PUBLIC_MAP_CENTER=
NEXT_PUBLIC_DEFAULT_CITY=
# new-event payment methods separated by ";" and registration form help text
NEXT_PUBLIC_DEFAULT_PAYMENT_METHODS=
NEXT_PUBLIC_PAYMENT_HINT=

# Web UI URL sub-path, e.g. /kuntorastit (empty = domain root). Baked in at
# build time; see README "Web-käyttöliittymä alipolussa".
NEXT_PUBLIC_BASE_PATH=
# Web UI's API base URL. Empty = <NEXT_PUBLIC_BASE_PATH>/api/v1.
NEXT_PUBLIC_API_BASE_URL=

# --- API + PostgreSQL (used by compose.api.yaml and services/api) ---
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name
PORT=3001
# API route prefixes (defaults: api/v1 and api/docs).
# API_PREFIX=api/v1
# API_DOCS_PATH=api/docs

# Signs admin login tokens. Set a real random value in production.
ADMIN_TOKEN_SECRET=kuntorastit-local-development-secret

# pc-client (Tauri): API base URL, read at build time via Vite (see
# clients/pc-client/vite.config.ts's envDir). Baked into the built app —
# not editable after the client is compiled.
VITE_API_BASE_URL=http://localhost:3001/api/v1
