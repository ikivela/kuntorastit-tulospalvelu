# Kehitysympäristön asetukset. Kopioi tiedostoksi .env.development.
# Samat muuttujien nimet kuin .env.production.example-tiedostossa.
#
# Lukijat:
# - web (npm run dev): Vite/vinext lataa .env.development automaattisesti
# - pc-client (npm run dev / tauri dev): lukee juuren .env.development
# - API + PostgreSQL Dockerissa:
#     docker compose -f compose.api.yaml --env-file .env.development up --build
# (.env* on gitignoressa — älä committaa oikeita salasanoja.)

# --- Sivusto ja seura (web-käyttöliittymä; upotetaan buildiin) ---
NEXT_PUBLIC_SITE_NAME=Kuntorastit
# Järjestävä seura: näytetään sivuston nimen alla, otsikoissa ja
# alatunnisteessa. Tyhjä = ei näytetä.
NEXT_PUBLIC_CLUB_NAME=
# Logo ja favicon: polku public/-kansiossa (esim. /brand/logo.png; kansio
# public/brand/ on gitignoressa) tai täysi https://-osoite.
# Tyhjä = neutraali oletuslogo (/logo.svg).
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_FAVICON_URL=
# Kartan oletuskeskipiste uudelle tapahtumalle "leveysaste,pituusaste"
# (tyhjä = koko Suomi) ja osoitehakuun lisättävä paikkakunta.
NEXT_PUBLIC_MAP_CENTER=
NEXT_PUBLIC_DEFAULT_CITY=
# Uuden tapahtuman oletusmaksutavat puolipisteellä eroteltuna ja ohjeteksti
# ilmoittautumislomakkeen maksutavan yläpuolella.
NEXT_PUBLIC_DEFAULT_PAYMENT_METHODS=
NEXT_PUBLIC_PAYMENT_HINT=

# Alipolku, esim. /kuntorastit (tyhjä = juuri). API:n osoite webille
# (tyhjä = <NEXT_PUBLIC_BASE_PATH>/api/v1; dev-palvelin välittää sen API:lle).
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_BASE_URL=

# --- API + PostgreSQL ---
POSTGRES_DB=kuntorastit
POSTGRES_USER=kuntorastit
POSTGRES_PASSWORD=kuntorastit
DATABASE_URL=postgresql://kuntorastit:kuntorastit@localhost:5432/kuntorastit
PORT=3001
ADMIN_TOKEN_SECRET=kuntorastit-local-development-secret

# --- pc-client ---
# API-osoite, jota kehitysversio käyttää.
VITE_API_BASE_URL=http://localhost:3001/api/v1
