# Tuotantoasetukset. Kopioi tiedostoksi .env.production ja käynnistä:
#   docker compose -f prod.yml --env-file .env.production up -d --build
# Samat muuttujien nimet kuin .env.development.example-tiedostossa.
# Myös pc-clientin tuotantobuild (npm run tauri build) lukee tämän
# tiedoston VITE_API_BASE_URL-arvon.
# (.env* on gitignoressa — älä committaa oikeita salasanoja.)

# --- Sivusto ja seura (web-käyttöliittymä; upotetaan buildiin) ---
NEXT_PUBLIC_SITE_NAME=Kuntorastit
# Järjestävä seura: näytetään sivuston nimen alla, otsikoissa ja
# alatunnisteessa. Tyhjä = ei näytetä.
NEXT_PUBLIC_CLUB_NAME=
# Logo ja favicon: polku public/-kansiossa (esim. /brand/logo.png; kansio
# public/brand/ on gitignoressa) tai täysi https://-osoite.
# Tyhjä = neutraali oletuslogo (/logo.svg).
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_FAVICON_URL=
# Kartan oletuskeskipiste uudelle tapahtumalle "leveysaste,pituusaste"
# (tyhjä = koko Suomi) ja osoitehakuun lisättävä paikkakunta.
NEXT_PUBLIC_MAP_CENTER=
NEXT_PUBLIC_DEFAULT_CITY=
# Uuden tapahtuman oletusmaksutavat puolipisteellä eroteltuna ja ohjeteksti
# ilmoittautumislomakkeen maksutavan yläpuolella.
NEXT_PUBLIC_DEFAULT_PAYMENT_METHODS=
NEXT_PUBLIC_PAYMENT_HINT=

# PC-clientin latauslinkki ylläpidon Ohjeet-sivulla (tyhjä = "pyydä
# asennuspaketti ylläpitäjältä"), esim.
# https://github.com/ikivela/kuntorastit-tulospalvelu/releases/tag/pc-client-latest
NEXT_PUBLIC_CLIENT_DOWNLOAD_URL=
# Lähdekoodin osoite Ohjeet-sivulla (tyhjä = ikivela/kuntorastit-tulospalvelu).
# Aseta omaan forkkiin, jos ajat muokattua versiota (AGPL-3.0).
NEXT_PUBLIC_SOURCE_URL=

# --- Polku (subpath) ---
# Tyhjä = domainin juuri, muuten esim. /kuntorastit (kauttaviivoilla ei
# ole väliä). Koskee web-käyttöliittymää, API:a (<polku>/api/v1),
# Swaggeria (<polku>/api/docs) ja gatewayta.
NEXT_PUBLIC_BASE_PATH=
# Tyhjä = <NEXT_PUBLIC_BASE_PATH>/api/v1 samasta osoitteesta (suositus).
# Aseta vain jos API on eri domainissa, esim. https://api.esimerkki.fi/api/v1
NEXT_PUBLIC_API_BASE_URL=

# --- pc-client ---
# Julkinen API-osoite, joka upotetaan jaettavaan lukijaohjelmaan,
# esim. https://tulokset.esimerkki.fi/kuntorastit/api/v1
VITE_API_BASE_URL=

# --- Docker (prod.yml, pohja docker-compose.example.yml) ---
COMPOSE_PROJECT_NAME=kuntorastit
RESTART_POLICY=unless-stopped
TZ=Europe/Helsinki
IMAGE_TAG=latest
API_IMAGE=kuntorastit-api
WEB_IMAGE=kuntorastit-web
NGINX_IMAGE_TAG=1.27-alpine
POSTGRES_IMAGE_TAG=17-alpine

# --- Ulkoiset portit ---
# Gateway (nginx): koko sovellus yhdestä portista. Laita TLS (https) tämän
# eteen esim. palvelimen omalla nginxillä tai Caddylla.
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_PORT=80
GATEWAY_SERVER_NAME=_
GATEWAY_MAX_BODY_SIZE=10m
# Julkisten lomakkeiden (ilmoittautuminen, lukijalaitteen rekisteröinti)
# pyyntörajoitus per IP: nopeus ja kerralla sallittu ylitys.
GATEWAY_FORM_RATE_LIMIT=20r/m
GATEWAY_FORM_RATE_BURST=20
# Content-Security-Policy. Tyhjä = oletus (ks. docker-compose.example.yml).
# Muuta esim. jos API on eri domainissa (connect-src) tai kalenteri
# upotetaan seuran sivulle iframella (frame-ancestors https://seura.fi).
# GATEWAY_CSP=
# Suorat portit palveluihin (oletuksena vain palvelimelta itseltään).
# 0.0.0.0 avaa portin kaikkiin verkkoihin.
WEB_BIND_ADDRESS=127.0.0.1
WEB_EXTERNAL_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_EXTERNAL_PORT=3001
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_EXTERNAL_PORT=5432

# --- PostgreSQL ---
POSTGRES_DB=kuntorastit
POSTGRES_USER=kuntorastit
# Pakollinen. Vältä merkkejä @ : / ? # (päätyy tietokantaosoitteeseen).
POSTGRES_PASSWORD=
# Nimetty volume (oletus) tai hostin polku, esim. /srv/kuntorastit/pgdata
POSTGRES_DATA=postgres-data

# --- API ---
# Pakollinen, vähintään 32 merkkiä: API ei käynnisty ilman sitä.
# Luo esim. `openssl rand -hex 32`. Vaihtaminen kirjaa kaikki ulos.
ADMIN_TOKEN_SECRET=
# admin-käyttäjän salasana, kun käyttäjä luodaan ensimmäisen kerran.
# Pakollinen ensimmäisellä käynnistyksellä (oletussalasanaa ei käytetä
# tuotannossa), vähintään 8 merkkiä. Ei muuta olemassa olevan käyttäjän
# salasanaa; vaihda salasana ylläpidon "Vaihda salasana" -napista.
ADMIN_INITIAL_PASSWORD=
# Tietokantamigraatiot käynnistyksen yhteydessä. Pidä true: ajaa vain
# puuttuvat migraatiot, ja ilman niitä tyhjässä kannassa ei ole tauluja.
RUN_MIGRATIONS=true
# Alustusdata: admin-käyttäjä (ilman sitä ylläpitoon ei voi kirjautua),
# tapahtumasarja, kausi ja esimerkkitapahtuma. Pidä true ensimmäisellä
# käynnistyksellä; sen jälkeen voi asettaa false, jottei poistettu
# esimerkkitapahtuma palaa uudelleenkäynnistyksessä.
RUN_SEED=true
