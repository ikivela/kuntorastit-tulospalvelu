{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuntorastit Client",
  "version": "0.3.3",
  "identifier": "fi.kuntorastit.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kuntorastit Client",
        "width": 900,
        "height": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http: https:; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "wix": {
        "upgradeCode": "b551f96e-eeb7-5784-b962-b7911546557b"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
