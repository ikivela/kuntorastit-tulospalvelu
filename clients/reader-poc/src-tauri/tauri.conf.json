{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maanantairastit Reader PoC",
  "version": "0.1.0",
  "identifier": "fi.maanantairastit.reader-poc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Maanantairastit - EMIT 250 PoC",
        "width": 900,
        "height": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true
  }
}
