# Tuotantoasetukset tuotanto.yml:lle. Kopioi tiedostoksi .env.tuotanto ja
# käynnistä:
#   docker compose -f tuotanto.yml --env-file .env.tuotanto up -d --build
# (.env* on gitignoressa — älä committaa oikeita salasanoja.)

# --- Yleiset ---
COMPOSE_PROJECT_NAME=kuntorastit
RESTART_POLICY=unless-stopped
TZ=Europe/Helsinki
IMAGE_TAG=latest
API_IMAGE=kuntorastit-api
WEB_IMAGE=kuntorastit-web

# --- Polku (subpath) ---
# Tyhjä = domainin juuri, muuten esim. /kuntorastit (kauttaviivoilla ei
# ole väliä). Koskee web-käyttöliittymää, API:a
# (<BASE_PATH>/api/v1) ja Swaggeria (<BASE_PATH>/api/docs).
# Upotetaan web-buildiin: muutoksen jälkeen aja `up -d --build`.
BASE_PATH=

# --- Web-käyttöliittymä (build-aikaiset) ---
SITE_NAME=Kuntorastit
# Järjestävä seura; näytetään sivuston nimen alla, otsikoissa ja alatunnisteessa.
# Tyhjä = ei näytetä.
CLUB_NAME=
# Logo ja favicon: polku public/-kansiossa (esim. /brand/logo.png) tai
# täysi https://-osoite. Tyhjä = neutraali oletuslogo (/logo.svg).
# public/brand/ on gitignoressa: kopioi seuran kuvat sinne palvelimella
# ennen buildia.
LOGO_URL=
FAVICON_URL=
# Kartan oletuskeskipiste uudelle tapahtumalle "leveysaste,pituusaste"
# (tyhjä = koko Suomi) ja osoitehakuun lisättävä paikkakunta.
MAP_CENTER=
DEFAULT_CITY=
# Uuden tapahtuman oletusmaksutavat puolipisteellä eroteltuna.
DEFAULT_PAYMENT_METHODS=
# Ohjeteksti ilmoittautumislomakkeen maksutavan yläpuolella
# (tyhjä = "Valitse haluamasi maksutapa.").
PAYMENT_HINT=
# Tyhjä = <BASE_PATH>/api/v1 samasta osoitteesta (suositus). Aseta vain jos
# API on eri domainissa, esim. https://api.esimerkki.fi/api/v1
WEB_API_BASE_URL=

# --- Ulkoiset portit ---
# Gateway (nginx): koko sovellus yhdestä portista. Laita TLS (https) tämän
# eteen esim. palvelimen omalla nginxillä/Caddylla tai aseta GATEWAY_PORT=80
# ja hoida TLS kuormantasaajassa.
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_PORT=80
GATEWAY_SERVER_NAME=_
GATEWAY_MAX_BODY_SIZE=10m

# Suorat portit palveluihin (oletuksena vain palvelimelta itseltään).
# 0.0.0.0 avaa portin kaikkiin verkkoihin.
WEB_BIND_ADDRESS=127.0.0.1
WEB_EXTERNAL_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_EXTERNAL_PORT=3001
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_EXTERNAL_PORT=5432

# --- PostgreSQL ---
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_DB=kuntorastit
POSTGRES_USER=kuntorastit
# Pakollinen. Vältä merkkejä @ : / ? # (päätyy DATABASE_URL:iin).
POSTGRES_PASSWORD=
# Nimetty volume (oletus) tai hostin polku, esim. /srv/kuntorastit/pgdata
POSTGRES_DATA=postgres-data

# --- API ---
# Pakollinen. Satunnainen pitkä merkkijono, esim. `openssl rand -hex 32`.
ADMIN_TOKEN_SECRET=
# admin-käyttäjän salasana, kun käyttäjä luodaan ensimmäisen kerran
# (tyhjä = mara2026). Vähintään 8 merkkiä. Ei muuta olemassa olevan
# käyttäjän salasanaa.
ADMIN_INITIAL_PASSWORD=
# Tietokantamigraatiot käynnistyksen yhteydessä. Pidä true: ajaa vain
# puuttuvat migraatiot, ja ilman niitä tyhjässä kannassa ei ole tauluja.
RUN_MIGRATIONS=true
# Alustusdata: admin-käyttäjä (ilman sitä ylläpitoon ei voi kirjautua),
# tapahtumasarja, kausi ja esimerkkitapahtuma. Pidä true ensimmäisellä
# käynnistyksellä; sen jälkeen voi asettaa false, jottei poistettu
# esimerkkitapahtuma palaa uudelleenkäynnistyksessä.
RUN_SEED=true

# --- nginx ---
NGINX_IMAGE_TAG=1.27-alpine
